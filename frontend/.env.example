# Set to true only after Google AdSense approval
NEXT_PUBLIC_ENABLE_ADS=false

# STATIC_EXPORT=true is only for production static builds (npm run build:static).
# Do NOT set it in .env.local — it breaks next dev (middleware, dynamic routes).

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-32-char-random-secret-here
AUTH_SECRET=generate-a-32-char-random-secret-here
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
